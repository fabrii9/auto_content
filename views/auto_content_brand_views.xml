<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vista_auto_content_brand_list" model="ir.ui.view">
        <field name="name">auto.content.brand.list</field>
        <field name="model">auto.content.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="llm_provider_id"/>
                <field name="llm_model"/>
                <field name="pack_loaded_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="vista_auto_content_brand_form" model="ir.ui.view">
        <field name="name">auto.content.brand.form</field>
        <field name="model">auto.content.brand</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test" type="object" string="Probar con la foto del paquete" class="btn-primary"
                            invisible="not test_photo_path or not llm_provider_id"
                            confirm="Se llama a la IA (tiene costo) y se arma una pieza de prueba. ¿Seguimos?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-picture-o">
                            <field name="request_count" widget="statinfo" string="Solicitudes"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la marca"/></h1>
                    </div>
                    <group>
                        <group string="Marca">
                            <field name="code" placeholder="capsic"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Paquete">
                            <field name="pack_file" filename="pack_filename"/>
                            <field name="pack_filename" invisible="1"/>
                            <field name="pack_loaded_at"/>
                            <field name="template_path"/>
                            <label for="width" string="Tamaño"/>
                            <div><field name="width" class="oe_inline"/> × <field name="height" class="oe_inline"/> px</div>
                            <field name="test_photo_path" invisible="1"/>
                        </group>
                        <group string="IA">
                            <field name="llm_provider_id"/>
                            <field name="llm_model"/>
                            <field name="llm_temperature"/>
                            <field name="llm_max_tokens"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lugares" name="places">
                            <field name="place_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="aliases"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ajustes de instrucciones" name="extra">
                            <field name="extra_instructions" placeholder="Por ejemplo: esta semana destacá la obra de la línea de Lomas Este."/>
                        </page>
                        <page string="Diseños" name="designs">
                            <field name="designs_json" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Instrucciones del paquete" name="instructions">
                            <field name="instructions"/>
                        </page>
                        <page string="Conocimiento del paquete" name="knowledge">
                            <field name="knowledge"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_auto_content_brand" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">auto.content.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cargá la primera marca</p>
            <p>Cada marca es un paquete .zip con la plantilla, la voz, los datos y los lugares del cliente.</p>
        </field>
    </record>
</odoo>
